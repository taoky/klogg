<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Klogg log viewer</title>
    <license file="COPYING"/>
    <welcome file="description.txt"/>
    
    <pkg-ref id="dev.filimonov.klogg"/>
    <options customize="never" require-scripts="false"/>
    <choices-outline>
        <line choice="default">
            <line choice="dev.filimonov.klogg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="dev.filimonov.klogg" visible="false">
        <pkg-ref id="dev.filimonov.klogg"/>
    </choice>
    <pkg-ref id="dev.filimonov.klogg" version="%klogg_version%" onConclusion="none">%klogg_pkg%</pkg-ref>
</installer-gui-script>
